# Targets keep their trailing slash on purpose. /salary-compass/ is a directory
# index in public/, so pointing at /salary-compass makes Pages 308 to the slashed
# form — turning every one of these into two hops for no reason.
#
# Only redirects whose destination exists in THIS project belong here — a 301 to
# a 404 is worse than the 404 it replaces. All destinations below verified 200 on
# production before being added.
/compensation/compare-salary    /salary-compass/  301
/compensation/compare-salary/   /salary-compass/  301
/compensation/compare-salary/*  /salary-compass/  301

# The Mental Health Series became Product Talks — /mentalhealth on Softr is
# already a byte-for-byte duplicate of /product-talks, and its own <title> says
# "Mental Health Series is now: Product Talks". A 301 instead of a second copy.
/mentalhealth                   /product-talks    301

