---
import Base from '../layouts/Base.astro';
import EventList from '../components/EventList.astro';
import JsonLd from '../components/JsonLd.astro';
import { organisation, webSite } from '../lib/schema';

// Built from index-static.html, the homepage that was rebuilt by hand months ago
// and never deployed — the tracked index.html is still the raw Softr dump.
//
// The "Upcoming events" block used to be four hardcoded cards with href="#".
// They now come from the Luma calendar, rendered at build and refreshed by the
// island so a new event appears without a deploy.
---

<Base
  title="The Impostor PM — a community for Product Managers"
  description="Clubs, Product Talks, Huddles and live salary data for Product Managers. Real-world practice over performance."
>
  {/* The publisher identity for the whole site. The other pages' blocks point at
      its @id rather than repeating it, so the name, logo and social profiles
      have one definition. */}
  <Fragment slot="head">
    <JsonLd data={organisation()} />
    <JsonLd data={webSite()} />
  </Fragment>
  <!-- ════════════ HERO ════════════ -->
  <header class="hero section-warm">
      <div class="container">
  <div class="row align-items-center">
      <div class="col-lg-6">
          <h1>Is the Impostor Syndrome hitting hard?</h1>
          <p class="hero-intro">&mdash; Others feel the same.</p>
          <p class="hero-body">Our community is that safe space where Product Managers grow by sharing their pains and learning from others, as a group.</p>
          <a href="https://theimpostorpm.fillout.com/t/dT7U9NSoghus" target="_blank" rel="noreferrer" class="btn-cta">Join the Community</a>
      </div>
      <div class="col-lg-6 hero-art">
          <img src="/img/home/05-5ae70aa4.webp" alt="Product Managers in conversation">
      </div>
  </div>
      </div>
  </header>


  <!-- ════════════ WHAT WE DO ════════════ -->
  <section class="section-white section-pad-lg">
      <div class="container">
  <div class="text-center mb-5">
      <h2 class="section-heading">What we do</h2>
      <p style="font-size:1.0625rem; color:#666; max-width:48rem; margin: 1rem auto 0;">Gain quick advice from other PMs, engage in discussions on hot topics, and meet other professionals willing to share their experiences. Whatever you need, this is your place:</p>
  </div>
  <div class="row">
      <div class="col-md-4 mb-4 mb-md-0">
          <div class="feature-card">
              <div class="feature-icon">
                  <img src="/img/home/06-8fcc3720.webp" alt="Product Talks">
              </div>
              <h3>Product Talks</h3>
              <p>An interactive webinar series where we sit down with real experts to have honest, practical conversations about their craft.</p>
              <a href="/product-talks" class="btn-link-custom">Learn more</a>
          </div>
      </div>
      <div class="col-md-4 mb-4 mb-md-0">
          <div class="feature-card">
              <div class="feature-icon">
                  <img src="/img/home/07-d3207af9.webp" alt="The Club">
              </div>
              <h3>The Club</h3>
              <p>These in-person community events will enable you to have meaningful discussions about the latest trends in the industry.</p>
              <a href="/club" class="btn-link-custom">Learn More</a>
          </div>
      </div>
      <div class="col-md-4">
          <div class="feature-card">
              <div class="feature-icon">
                  <img src="/img/home/08-69d5c730.svg" alt="Huddle">
              </div>
              <h3>Huddle</h3>
              <p>An intimate, expert-led mentoring session where Product Managers bring real challenges and leave with clarity.</p>
              <a href="https://www.impostor.pm/huddle/" class="btn-link-custom">Learn more</a>
          </div>
      </div>
  </div>
      </div>
  </section>


  <!-- ════════════ UPCOMING EVENTS ════════════ -->
  <section class="ue-section" aria-labelledby="ue-heading">
    <div class="ue-container">
      <h2 class="ue-title" id="ue-heading">Upcoming events</h2>

      <EventList
        period="future"
        limit={4}
        emptyMessage="Nothing on the calendar right now — new events go up on Luma first."
      />

      <div class="ue-footer-link">
        <a href="/events"><span>See the full calendar</span> <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ════════════ GALLERY MARQUEE ════════════ -->
  <section class="gallery-marquee" aria-label="Community moments">
      <div class="gallery-track">
  <img src="/img/home/10-b708b77b.webp" alt="">
  <img src="/img/home/11-eb9ce009.webp" alt="">
  <img src="/img/home/12-167df795.webp" alt="">
  <img src="/img/home/13-a5cffae9.webp" alt="">
  <img src="/img/home/14-8fe3d258.webp" alt="">
  <img src="/img/home/15-5addaeac.webp" alt="">
  <img src="/img/home/16-0beef04e.webp" alt="">
  <img src="/img/home/17-76c27053.webp" alt="">
  <img src="/img/home/18-9165c82a.webp" alt="">
  <img src="/img/home/19-31adec29.webp" alt="">
  <!-- duplicate for infinite loop -->
  <img src="/img/home/10-b708b77b.webp" alt="" aria-hidden="true">
  <img src="/img/home/11-eb9ce009.webp" alt="" aria-hidden="true">
  <img src="/img/home/12-167df795.webp" alt="" aria-hidden="true">
  <img src="/img/home/13-a5cffae9.webp" alt="" aria-hidden="true">
  <img src="/img/home/14-8fe3d258.webp" alt="" aria-hidden="true">
  <img src="/img/home/15-5addaeac.webp" alt="" aria-hidden="true">
  <img src="/img/home/16-0beef04e.webp" alt="" aria-hidden="true">
  <img src="/img/home/17-76c27053.webp" alt="" aria-hidden="true">
  <img src="/img/home/18-9165c82a.webp" alt="" aria-hidden="true">
  <img src="/img/home/19-31adec29.webp" alt="" aria-hidden="true">
      </div>
  </section>

  <!-- ════════════ SALARY COMPASS ════════════ -->
  {/* Replaced the Mental Health block, and absorbs the golden "State of Product
      Compensation" strip that used to sit further down. The card is a trimmed
      copy of the /compensation hero mockup. On mobile it sits between the copy
      and the CTAs, hence the grid instead of two Bootstrap columns. */}
  <section class="sc-section" aria-labelledby="sc-heading">
      <div class="container sc-grid">
      <div class="sc-copy">
          <h2 id="sc-heading">How does your Product Manager salary compare?</h2>
          <p>The Product Salary Compass tells you if your pay is below, at, or above market, against real Product Managers rather than job-board ranges. It&rsquo;s free, anonymous and built from PM-only data shared by our community.</p>
      </div>
      <div class="sc-art">
          <div class="sc-card" aria-hidden="true">
              <div class="sc-card-head">
                  <span>Your result</span>
                  <span class="sc-pill">Top 38%</span>
              </div>
              <div class="sc-amount">€68,000</div>
              <div class="sc-cohort">Senior PM · 5–8 yrs · Portugal · SaaS</div>
              <svg class="sc-gauge" viewBox="0 0 240 150" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                      <linearGradient id="scGaugeFill" x1="0%" y1="0%" x2="100%" y2="0%">
                          <stop offset="0%" stop-color="#ffe680"/>
                          <stop offset="100%" stop-color="#ffc600"/>
                      </linearGradient>
                  </defs>
                  <path d="M20 120 A100 100 0 0 1 220 120" stroke="#3a3a3a" stroke-width="14" fill="none" stroke-linecap="round"/>
                  <path d="M20 120 A100 100 0 0 1 156.8 27" stroke="url(#scGaugeFill)" stroke-width="14" fill="none" stroke-linecap="round"/>
                  <g transform="rotate(21.6 120 120)">
                      <line x1="120" y1="120" x2="120" y2="40" stroke="#ffffff" stroke-width="3" stroke-linecap="round"/>
                      <circle cx="120" cy="120" r="6" fill="#ffffff"/>
                  </g>
                  <text x="20" y="142" font-size="10" font-family="Inter" fill="#8a8a8a" text-anchor="middle">€0</text>
                  <text x="220" y="142" font-size="10" font-family="Inter" fill="#8a8a8a" text-anchor="middle">€130k</text>
              </svg>
          </div>
      </div>
      <div class="sc-cta-row">
          <a href="/salary-compass/" class="btn-cta">Compare my PM salary</a>
          <a href="/compensation" class="sc-link">How it works</a>
      </div>
      </div>
  </section>


  <!-- ════════════ TESTIMONIALS (Senja) ════════════ -->
  <section class="section-white section-pad">
      <div class="container">
  <script src="https://widget.senja.io/widget/0e45a7a8-f5b1-4a72-8ca2-2b198d0d400f/platform.js" type="text/javascript" async></script>
  <div class="senja-embed" data-id="0e45a7a8-f5b1-4a72-8ca2-2b198d0d400f" data-mode="shadow" data-lazyload="false" style="display: block; width: 100%;"></div>
      </div>
  </section>

  <!-- ════════════ SUPPORT MISSION CTA ════════════ -->
  <section class="cta-support">
      <div class="container">
  <div class="row align-items-center">
      <div class="col-md-8 mb-3 mb-md-0">
          <h2>Do you want to support our Mission?</h2>
          <p>All of our initiatives are free of charge for our Community. But we still have costs, so if you want to support us, why not buy us a Coffee?</p>
      </div>
      <div class="col-md-4 text-md-right">
          <a href="https://ko-fi.com/impostorpm" target="_blank" rel="noreferrer" class="btn-cta">Buy us a &#9749;&#65039;!</a>
      </div>
  </div>
      </div>
  </section>

  <!-- ════════════ PARTNERS ════════════ -->
  <section class="partner-section">
      <div class="container">
  <h2>Where product conversations came to life</h2>
  <p>Thank you for making space for Product Managers to grow.</p>
      </div>
      <div class="partner-marquee">
  <div class="partner-track">
      <img src="/img/home/20-22462e06.webp" alt="Partner">
      <img src="/img/home/21-4b40c7d9.webp" alt="Partner">
      <img src="/img/home/22-f4c9a7db.webp" alt="Partner">
      <img src="/img/home/23-7601f511.webp" alt="Partner">
      <img src="/img/home/24-12831db3.webp" alt="Partner">
      <img src="/img/home/25-6660ca58.webp" alt="Partner">
      <!-- duplicate -->
      <img src="/img/home/20-22462e06.webp" alt="" aria-hidden="true">
      <img src="/img/home/21-4b40c7d9.webp" alt="" aria-hidden="true">
      <img src="/img/home/22-f4c9a7db.webp" alt="" aria-hidden="true">
      <img src="/img/home/23-7601f511.webp" alt="" aria-hidden="true">
      <img src="/img/home/24-12831db3.webp" alt="" aria-hidden="true">
      <img src="/img/home/25-6660ca58.webp" alt="" aria-hidden="true">
  </div>
      </div>
  </section>

</Base>

<style is:global>
  /* Global rather than scoped for the same reason as /compensation: the marquee
     and the Senja widget both touch the DOM after render. Everything shared with
     another page already lives in base.css. */
      <style>
  /* ─── Tokens ─── */
  :root {
      --white: #ffffff;
      --warm-yellow: #fff3cf;
      --warm-cream: #fffaeb;
      --golden: #ffc600;
      --near-black: #1e1e1e;
      --black: #000000;
      --text-muted: #6b6b6b;
      --border-soft: #e6e6e6;
      --light-gray: #f5f5f5;
  }

  html { scroll-behavior: smooth; font-size: 16px; overflow-x: hidden; background-color: var(--white); }
  body {
      font-family: "Inter", sans-serif;
      font-weight: 300;
      color: var(--black);
      background-color: var(--white);
      line-height: 1.5;
  }

  .container { max-width: 100%; }
  @media (min-width: 576px) { .container { max-width: 540px; } }
  @media (min-width: 768px) { .container { max-width: 720px; } }
  @media (min-width: 992px) { .container { max-width: 960px; } }
  @media (min-width: 1200px) { .container { max-width: 1140px; } }

  h1, h2, h3, h4, h5, h6 {
      font-family: "Inter", sans-serif;
      font-weight: 700;
      color: var(--black);
      white-space: pre-line;
  }
  p { white-space: pre-line; }

  .section-warm  { background-color: var(--warm-yellow); }
  .section-cream { background-color: var(--warm-cream); }
  .section-dark  { background-color: var(--near-black); color: var(--white); }
  .section-dark h1, .section-dark h2, .section-dark h3, .section-dark h4 { color: var(--white); }
  .section-white { background-color: var(--white); }
  .section-light { background-color: var(--light-gray); }
  .section-golden { background-color: var(--golden); }
  .section-pad   { padding: 4rem 0; }
  .section-pad-lg { padding: 6rem 0; }

  /* ─── Buttons ─── */
  .btn-outline-custom {
      background: transparent;
      color: var(--black);
      border: 1.5px solid var(--black);
      border-radius: .25rem;
      padding: .65rem 1.75rem;
      font-weight: 400;
      transition: background .2s, color .2s;
  }
  .btn-outline-custom:hover { background: var(--black); color: var(--white); text-decoration: none; }

  .btn-link-custom {
      color: var(--near-black);
      font-weight: 500;
      text-decoration: none;
      border-bottom: 1.5px solid var(--golden);
      padding-bottom: 2px;
      transition: color .2s, border-color .2s;
  }
  .btn-link-custom:hover { color: var(--black); border-bottom-color: var(--black); text-decoration: none; }

  /* ─── Navbar ─── */
  .navbar-site {
      background-color: var(--black);
      padding: 0;
      position: sticky;
      top: 0;
      z-index: 800;
      border-bottom: 2px solid var(--golden);
  }
  .navbar-site .container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 56px;
  }
  .navbar-site .navbar-brand { padding: 0; margin: 0; display: flex; align-items: center; }
  .navbar-site .navbar-brand img { height: 2rem; width: auto; }
  @media (max-width: 576px) { .navbar-site .navbar-brand img { max-width: 10rem; } }

  .navbar-site .nav-link {
      color: var(--white) !important;
      font-family: "Inter", sans-serif;
      font-weight: 300;
      font-size: .875rem;
      line-height: 1.25rem;
      padding: 1rem .875rem !important;
      opacity: .85;
      transition: opacity .15s;
  }
  .navbar-site .nav-link:hover, .navbar-site .nav-link:focus { opacity: 1; }

  .navbar-site .dropdown-menu {
      background-color: var(--black);
      border: 1px solid #333;
      border-radius: 8px;
      box-shadow: 0 8px 24px rgba(0,0,0,.4);
      padding: .5rem 0;
      margin-top: .25rem;
      min-width: 10rem;
  }
  .navbar-site .dropdown-item {
      font-family: "Inter", sans-serif;
      font-weight: 300;
      font-size: .875rem;
      padding: .5rem 1rem;
      color: var(--white);
      opacity: .85;
  }
  .navbar-site .dropdown-item:hover, .navbar-site .dropdown-item:focus {
      background-color: #1a1a1a;
      color: var(--white);
      opacity: 1;
  }
  .navbar-site .btn-nav {
      color: var(--black);
      font-family: "Inter", sans-serif;
      font-weight: 400;
      font-size: .875rem;
      background: var(--white);
      border: 1px solid var(--white);
      border-radius: 6px;
      padding: .4rem 1.1rem;
      line-height: 1.25rem;
      transition: opacity .15s;
  }
  .navbar-site .btn-nav:hover { opacity: .88; color: var(--black); text-decoration: none; }

  .navbar-site .navbar-toggler { border: none; padding: .25rem; }
  .navbar-site .navbar-toggler:focus { outline: none; box-shadow: none; }
  .navbar-site .navbar-toggler-icon {
      background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' width='30' height='30' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255, 255, 255, 0.85%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
      width: 1.25em;
      height: 1.25em;
  }
  .navbar-site .navbar-collapse { background-color: var(--black); }
  @media (max-width: 991px) {
      .navbar-site .navbar-collapse { padding: .5rem 0 1rem; }
      .navbar-site .btn-nav { display: inline-block; margin: .5rem 0 .25rem .875rem; }
  }

  /* ─── Hero ─── */
  .hero { padding: 5rem 0 5.5rem; }
  .hero h1 {
      font-size: 3rem;   /* 48px, medido en el original */
      line-height: 1.5;
      letter-spacing: -.01em;
      font-weight: 700;
      margin-bottom: 1.5rem;
  }
  .hero .hero-intro {
      font-size: 1rem;
      color: #1e1e1e;
      line-height: 1.5;
      margin: 0 0 1.5rem;
      max-width: 32rem;
      white-space: normal;
  }
  .hero .hero-body {
      font-size: 1rem;
      color: #444;
      line-height: 1.5;
      margin-bottom: 2.25rem;
      max-width: 32rem;
      white-space: normal;
  }
  /* ─── Canonical CTA (golden primary, site-wide) ─── */
  .btn-cta {
      background-color: var(--golden);
      color: var(--near-black);
      font-family: "Inter", sans-serif;
      font-weight: 500;
      font-size: .9375rem;
      line-height: 1.4;
      border: none;
      border-radius: .5rem;
      padding: .65rem 1.25rem;
      transition: opacity .2s;
      display: inline-block;
      text-align: center;
      text-decoration: none;
  }
  .btn-cta:hover { opacity: .88; color: var(--near-black); text-decoration: none; }

  /* Dark variant — same proportions, inverted colors */
  .btn-cta-dark {
      background-color: var(--near-black);
      color: var(--white);
      font-family: "Inter", sans-serif;
      font-weight: 500;
      font-size: .9375rem;
      line-height: 1.4;
      border: none;
      border-radius: .5rem;
      padding: .65rem 1.25rem;
      transition: opacity .2s;
      display: inline-block;
      text-align: center;
      text-decoration: none;
  }
  .btn-cta-dark:hover { opacity: .88; color: var(--white); text-decoration: none; }
  .hero-art {
      display: flex;
      justify-content: center;
      align-items: center;
  }
  .hero-art img {
      max-width: 100%;
      height: auto;
      max-height: 440px;
  }
  @media (max-width: 991px) {
      .hero { padding: 3rem 0 3.5rem; }
      /* 48px / 1.5, measured on the Softr original at a 420px viewport. Was
         2.5rem, which is a fifth smaller and made the hero read as timid. */
      .hero h1 { font-size: 3rem; line-height: 1.5; }
      .hero-art { margin-top: 2rem; }
  }

  /* ─── Feature Grid (What we do) ─── */
  .feature-card {
      text-align: center;
      padding: 1.5rem 1rem;
  }
  .feature-card .feature-icon {
      width: 3.5rem;
      height: 3.5rem;
      margin: 0 auto 1.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
  }
  .feature-card .feature-icon img { max-width: 100%; max-height: 100%; }
  .feature-card h3 {
      font-size: 1.125rem;
      font-weight: 700;
      margin-bottom: .75rem;
  }
  .feature-card p {
      font-size: .9375rem;
      color: #555;
      line-height: 1.5;
      margin-bottom: 1rem;
  }

  /* ─── Salary Compass (dark) ─── */
  .sc-section {
      background-color: var(--near-black);
      color: var(--white);
      padding: 5rem 0;
  }
  .sc-section h2 { color: var(--white); font-size: 2.25rem; margin-bottom: 1.25rem; font-weight: 700; white-space: normal; }
  .sc-section p { color: #d4d4d4; font-size: 1rem; line-height: 1.5; margin-bottom: 1.75rem; white-space: normal; }
  /* Desktop: copy and CTAs stacked on the left, card spanning the right.
     Mobile (below): one column, card between the copy and the CTAs. */
  .sc-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-areas: "copy art" "cta art";
      column-gap: 4rem;
      align-items: center;
  }
  .sc-copy { grid-area: copy; align-self: end; }
  .sc-art { grid-area: art; }
  .sc-cta-row { grid-area: cta; align-self: start; display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; }
  .sc-link {
      color: var(--white);
      font-weight: 500;
      text-decoration: none;
      border-bottom: 1.5px solid var(--golden);
      padding-bottom: 2px;
  }
  .sc-link:hover { color: var(--golden); text-decoration: none; }

  /* No card surface: the illustration sits straight on the dark band, framed
     by a hairline border. */
  .sc-card {
      color: var(--white);
      border: 1px solid #3a3a3a;
      border-radius: .75rem;
      padding: 1.75rem;
      max-width: 26rem;
      margin: 0 auto;
  }
  .sc-card-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: .75rem;
      font-weight: 600;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: #a3a3a3;
  }
  .sc-pill {
      background: var(--golden);
      color: var(--near-black);
      border-radius: 999px;
      padding: .2rem .7rem;
      letter-spacing: 0;
      text-transform: none;
      font-size: .8125rem;
  }
  .sc-amount { font-size: 2.25rem; font-weight: 700; margin-top: .75rem; line-height: 1.2; }
  .sc-cohort { font-size: .875rem; color: #a3a3a3; margin-bottom: 1rem; }
  .sc-gauge { display: block; width: 100%; max-width: 280px; margin: 0 auto; }

  @media (max-width: 991px) {
      .sc-section { padding: 3.5rem 0; }
      .sc-grid {
          grid-template-columns: 1fr;
          grid-template-areas: "copy" "art" "cta";
          text-align: center;
      }
      .sc-section p { margin-bottom: 2rem; }
      .sc-card { padding: 1.25rem; text-align: left; }
      .sc-amount { font-size: 1.875rem; }
      .sc-cta-row { flex-direction: column; gap: 1.25rem; margin-top: 2rem; }
  }
  @media (max-width: 575px) {
      .sc-cta-row .btn-cta { width: 100%; }
  }

  /* ─── Gallery marquee ─── */
  .gallery-marquee {
      overflow: hidden;
      padding: 2rem 0;
      position: relative;
      background: var(--white);
  }
  .gallery-track {
      display: flex;
      gap: 1rem;
      width: max-content;
      animation: gallery-scroll 60s linear infinite;
  }
  .gallery-track img {
      height: 240px;
      width: auto;
      border-radius: .5rem;
      object-fit: cover;
