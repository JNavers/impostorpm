---
import Base from '../layouts/Base.astro';
import BookingForm from '../components/BookingForm.astro';
---

<Base
  title="Book a seat at Land Cowork — The Impostor PM"
  description="Request a seat at Land Cowork in Porto and get a 10% discount as a member of The Impostor PM community."
>
  <header class="section-warm booking-hero">
    <div class="container">
      <h1>Book a seat at Land Cowork</h1>
      <p class="booking-lede">
        Do you want to work in a unique place in Porto? Fill out the form with your request, and a member of Land will confirm your seat shortly.
      </p>
      <p class="booking-perk">By using this form, you will directly obtain a 10% discount from The Impostor PM.</p>
    </div>
  </header>

  <section class="section-white section-pad-lg">
    <div class="container">
      <BookingForm kind="landcowork-booking" successMessage="Thanks — your request is with Land. They'll confirm your seat shortly." />
    </div>
  </section>
</Base>

<style>
  .booking-hero { padding: 4.5rem 0 3rem; }
  .booking-hero h1 { font-size: 2.75rem; line-height: 1.5; letter-spacing: -0.04em; margin-bottom: 1rem; }
  .booking-lede { font-size: 1rem; color: var(--tipm-text-muted); max-width: 56ch; margin-bottom: 0.75rem; }
  .booking-perk { font-weight: 600; color: var(--tipm-black); max-width: 56ch; margin: 0; }
  @media (max-width: 768px) { .booking-hero h1 { font-size: 2rem; } }
</style>
