---
import Base from '../../layouts/Base.astro';
import { REFERRAL_ROLES, type ReferralRole } from '../../lib/referrals';

// One page per role, linked from the newsletter's "Who should we know?"
// section. noindex: these are for people we send here, not for search, and the
// sitemap filter in astro.config.mjs excludes /talent to match. The page used
// to live at /refer/<role>; public/_redirects keeps those links working.
//
// The page walks one decision: here is the role, does it fit you? Then apply.
// If not, do you know someone? Then refer them. If not, pass it on. The form
// sits beside the role on desktop and stays in view while people read, only
// the contact field is required, and /talent/<role>#refer-someone opens it
// straight in referral mode (for links from "Who should we know?").
export function getStaticPaths() {
  return REFERRAL_ROLES.map((role) => ({ params: { role: role.slug }, props: { role } }));
}

const { role } = Astro.props as { role: ReferralRole };

const place = role.location.replace(/^Available to be at the /, '');
const shareText = `${role.company} is hiring: ${role.seniority} Product, ${place}. Is it you, or someone you know? Apply or refer in 10 seconds:`;
const companyHost = role.companyUrl ? new URL(role.companyUrl).host.replace(/^www\./, '') : '';
---

<Base title={`${role.title} | The Impostor PM`} description={role.lede} noindex>
  <div class="refer-page" data-role={role.slug} data-share-text={shareText} data-share-title={`${role.title} | The Impostor PM`}>
    <div class="refer-top">
      <div class="container">
        <div class="refer-grid">
          <header class="refer-intro">
            <p class="tipm-eyebrow">Open role · We're helping {role.company} hire</p>
            <h1>{role.title}</h1>
            <p class="refer-lede">{role.lede}</p>
            <div class="refer-facts" role="list">
              <span role="listitem" class="refer-chip"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6" /></svg>{role.company}</span>
              <span role="listitem" class="refer-chip"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-8M22 20H2" /></svg>{role.seniority}</span>
              <span role="listitem" class="refer-chip"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>{place}</span>
            </div>
            <div class="refer-hero-cta">
              <a href="#refer" class="btn-cta btn-lg-custom" data-mode="self">I'm interested</a>
              <a href="#refer" class="btn-outline-custom" data-mode="other">I know someone</a>
            </div>
            <p class="refer-reassure">Apply or refer in 10 seconds · no CV · no account</p>
          </header>

          <aside class="refer-aside" id="refer">
            <div class="refer-card">
              <form id="refer-form" novalidate>
                <p class="tipm-eyebrow refer-card-eyebrow">10 seconds · no CV needed</p>
                <h2 class="refer-card-title" data-self="Sounds like you?" data-other="Who comes to mind?">Sounds like you?</h2>

                <fieldset class="refer-toggle">
                  <legend class="sr-only">Is this role for you, or for someone you know?</legend>
                  <label><input type="radio" name="who" value="self" checked /><span>Yes, I'm interested</span></label>
                  <label><input type="radio" name="who" value="other" /><span>I know someone</span></label>
                </fieldset>

                <label class="refer-field">
                  <span class="refer-field-label"><span data-self="Your LinkedIn or email" data-other="Their LinkedIn or email">Your LinkedIn or email</span> <abbr title="required">*</abbr></span>
                  <input type="text" name="contact" required autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="linkedin.com/in/… or email" aria-describedby="contact-hint" />
                  <span class="refer-hint" id="contact-hint" data-default="That's all we need. The rest is optional.">That's all we need. The rest is optional.</span>
                </label>

                <label class="refer-field refer-other-only" hidden>
                  <span class="refer-field-label">Their name <em>optional</em></span>
                  <input type="text" name="candidateName" autocomplete="off" />
                </label>

                <label class="refer-field">
                  <span class="refer-field-label"><span data-self="Anything we should know?" data-other="Why them?">Anything we should know?</span> <em>optional</em></span>
                  <textarea name="why" rows="2" placeholder="One line is enough."></textarea>
                </label>

                <div class="refer-other-only refer-you" hidden>
                  <p class="refer-field-label">About you <em>optional</em></p>
                  <p class="refer-help">So we can thank you and tell you how it goes.</p>
                  <div class="refer-pair">
                    <label class="refer-field"><span class="sr-only">Your name</span><input type="text" name="referrerName" autocomplete="name" placeholder="Your name" /></label>
                    <label class="refer-field"><span class="sr-only">Your email</span><input type="email" name="referrerEmail" autocomplete="email" placeholder="Your email" /></label>
                  </div>
                </div>

                {/* Honeypot. Hidden from people and screen readers; bots fill it. */}
                <label class="refer-hp" aria-hidden="true">
                  Website <input type="text" name="website" tabindex="-1" autocomplete="off" />
                </label>

                <button type="submit" class="btn-cta btn-lg-custom refer-submit"><span data-self="I'm interested" data-other="Send referral">I'm interested</span> <span aria-hidden="true">→</span></button>
                <p class="refer-status" role="status" aria-live="polite"></p>
                <p class="refer-fine" data-self="It goes straight to the TIPM team, and we get back to you personally." data-other="It goes straight to the TIPM team. We reach out to them personally.">It goes straight to the TIPM team, and we get back to you personally.</p>
              </form>

              <div class="refer-done" hidden>
                <span class="refer-done-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg></span>
                <h2 class="refer-card-title" tabindex="-1" data-self="Thanks, we'll be in touch." data-other="Thanks, we've got it.">Thanks, we'll be in touch.</h2>
                <p data-self="We'll get back to you personally. Do you know someone else who'd fit too?" data-other="We'll take it from here. Does anyone else come to mind?">We'll get back to you personally. Do you know someone else who'd fit too?</p>
                <button type="button" class="btn-cta-dark refer-again" data-self="Refer someone" data-other="Refer someone else">Refer someone</button>
                <p class="refer-done-share">Or pass the role on to someone who might know them:</p>
                <div class="refer-share-buttons"></div>
              </div>
            </div>
          </aside>

          <div class="refer-brief">
            <p class="tipm-eyebrow">The profile</p>
            <h2>What {role.company} needs</h2>
            <div class="refer-needs" role="list">
              {role.requirements.map((r) => (
                <div class="refer-need" role="listitem">
                  <span class="refer-tick" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg></span>
                  <div><strong>{r.title}</strong><span>{r.body}</span></div>
                </div>
              ))}
            </div>

            <dl class="refer-dl">
              <div><dt>Seniority</dt><dd>{role.seniority}</dd></div>
              <div><dt>Location</dt><dd>{role.location}</dd></div>
            </dl>

            <p class="refer-note"><strong>No need to be actively looking.</strong> If this sounds like you, we'd still like to meet you. The same goes for anyone you refer.</p>

            <div class="refer-prompts">
              <p class="refer-prompts-title">Not you? Think of…</p>
              <div role="list">
                {role.prompts.map((p) => <p role="listitem">{p}</p>)}
              </div>
              <a href="#refer" class="refer-prompts-cta" data-mode="other">Refer them <span aria-hidden="true">→</span></a>
            </div>

            <div class="refer-company">
              <p class="tipm-eyebrow">About {role.company}</p>
              <p>{role.companyBlurb}</p>
              {role.companyUrl && <a href={role.companyUrl} target="_blank" rel="noopener" class="refer-link">{companyHost} <span aria-hidden="true">↗</span></a>}
            </div>
          </div>
        </div>
      </div>
    </div>

    <section class="section-light section-pad refer-how">
      <div class="container">
        <p class="tipm-eyebrow">How it works</p>
        <h2>Apply or refer. We do the rest.</h2>
        <div class="refer-steps" role="list">
          <div class="refer-step" role="listitem">
            <span class="refer-step-n">1</span>
            <h3>You tell us who</h3>
            <p>Your LinkedIn or email if it's you, theirs if it's someone you know. No CV, no account.</p>
          </div>
          <div class="refer-step" role="listitem">
            <span class="refer-step-n">2</span>
            <h3>We reach out personally</h3>
            <p>A first conversation to see if there's a fit, before anything goes to {role.company}. Fine if you're not actively looking.</p>
          </div>
          <div class="refer-step" role="listitem">
            <span class="refer-step-n">3</span>
            <h3>You hear back</h3>
            <p>Whether you applied or referred someone, we'll let you know how it goes.</p>
          </div>
        </div>

        <div class="refer-why">
          <div class="refer-photos" aria-hidden="true">
            <img src="/img/home/12-167df795.webp" alt="" loading="lazy" />
            <img src="/img/home/15-5addaeac.webp" alt="" loading="lazy" />
            <img src="/img/home/17-76c27053.webp" alt="" loading="lazy" />
          </div>
          <div>
            <h3>Why through The Impostor PM?</h3>
            <p>The best PM opportunities don't come from a pile of CVs, but from someone who knows the right person. That's what our community does. And why companies trust us: we put people first.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section-golden section-pad refer-pass" id="share">
      <div class="container">
        <h2>Not a fit? Share it with your network.</h2>
        <p>Pass this role on to one person with a good Product network. It takes less time than reading this sentence.</p>
        <div class="refer-share-buttons"></div>
      </div>
    </section>
  </div>

  <template id="refer-share-tpl">
    <button type="button" class="refer-share-btn" data-channel="linkedin"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="fill" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.8v1.5h.05c.53-1 1.83-2 3.77-2 4.03 0 4.78 2.65 4.78 6.1v5.4h-4v-4.8c0-1.15-.02-2.62-1.6-2.62-1.6 0-1.85 1.25-1.85 2.54v4.88h-4v-11Z" /></svg>LinkedIn</button>
    <button type="button" class="refer-share-btn" data-channel="whatsapp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 20.5 5 16a8.5 8.5 0 1 1 3.1 3.1L3.5 20.5Z" /><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 .8a4.5 4.5 0 0 1-2.3-2.3l.8-1-1-2L9 8.5Z" /></svg>WhatsApp</button>
    <button type="button" class="refer-share-btn" data-channel="email"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6.5 8.5-6.5" /></svg>Email</button>
    <button type="button" class="refer-share-btn" data-channel="copy"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1" /><path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1" /></svg><span>Copy link</span></button>
  </template>
</Base>

<script>
  const MAILTO = 'general@impostor.pm';
  // Same checks as functions/api/referral.js, so the page never promises
  // something the endpoint then rejects.
  const EMAIL_RE = /^[^@\s]+@[^@\s.]+\.[^@\s]+$/;
  const LINKEDIN_RE = /^(https?:\/\/)?([a-z]{2,3}\.)?linkedin\.com\/in\/[^\s/?#]+/i;

  const page = document.querySelector('.refer-page') as HTMLElement | null;
  const form = document.getElementById('refer-form') as HTMLFormElement | null;
  const done = document.querySelector('.refer-done') as HTMLElement | null;
  const track = (event: string, props: Record<string, unknown>) => {
    const ph = (window as any).posthog;
    if (ph && typeof ph.capture === 'function') ph.capture(event, props);
  };

  // Where the visitor came from (newsletter, a share, LinkedIn…), so we can see
  // which channel actually produces referrals.
  const params = new URLSearchParams(location.search);
  const source = [params.get('utm_source') ?? params.get('ref'), params.get('utm_medium')].filter(Boolean).join(' / ');

  if (page) {
    const role = page.dataset.role ?? '';
    const text = page.dataset.shareText ?? '';
    const shareUrl = (channel: string) => `${location.origin}${location.pathname}?utm_source=share&utm_medium=${channel}`;

    const share = (channel: string) => {
      const url = shareUrl(channel);
      track('referral_shared', { role, channel });
      if (channel === 'linkedin') window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`, '_blank', 'noopener');
      if (channel === 'whatsapp') window.open(`https://wa.me/?text=${encodeURIComponent(`${text} ${url}`)}`, '_blank', 'noopener');
      if (channel === 'email') location.href = `mailto:?subject=${encodeURIComponent(page.dataset.shareTitle ?? '')}&body=${encodeURIComponent(`${text}\n\n${url}`)}`;
    };

    const tpl = document.getElementById('refer-share-tpl') as HTMLTemplateElement;
    document.querySelectorAll<HTMLElement>('.refer-share-buttons').forEach((slot) => {
      slot.append(tpl.content.cloneNode(true));
      slot.querySelectorAll<HTMLButtonElement>('.refer-share-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const channel = btn.dataset.channel ?? '';
          if (channel !== 'copy') return share(channel);
          const label = btn.querySelector('span') as HTMLElement;
          try {
            await navigator.clipboard.writeText(shareUrl('link'));
            label.textContent = 'Copied!';
          } catch {
            label.textContent = 'Copy failed';
          }
          track('referral_shared', { role, channel: 'copy' });
          setTimeout(() => (label.textContent = 'Copy link'), 2000);
        });
      });
    });

  }

  if (page && form && done) {
    const status = form.querySelector('.refer-status') as HTMLElement;
    const button = form.querySelector('button[type=submit]') as HTMLButtonElement;
    const contact = form.querySelector('input[name=contact]') as HTMLInputElement;
    const hint = form.querySelector('#contact-hint') as HTMLElement;
    const isSelf = () => (form.querySelector('input[name=who]:checked') as HTMLInputElement).value === 'self';

    // "self" = applying, "other" = referring someone. Every [data-self]/[data-other]
    // text on the page follows the mode.
    const syncWho = () => {
      const self = isSelf();
      form.querySelectorAll<HTMLElement>('.refer-other-only').forEach((el) => (el.hidden = self));
      page.querySelectorAll<HTMLElement>('[data-other]').forEach((el) => {
        el.textContent = (self ? el.dataset.self : el.dataset.other) ?? el.textContent;
      });
    };
    const setMode = (mode: string) => {
      (form.querySelector(`input[name=who][value=${mode}]`) as HTMLInputElement).checked = true;
      syncWho();
    };
    form.querySelectorAll('input[name=who]').forEach((el) => el.addEventListener('change', syncWho));
    page.querySelectorAll<HTMLElement>('a[data-mode]').forEach((a) =>
      a.addEventListener('click', () => {
        setMode(a.dataset.mode ?? 'self');
        done.hidden = true;
        form.hidden = false;
      }),
    );
    if (location.hash === '#refer-someone') setMode('other');

    // Confirm what we recognised as they type; only complain once they leave the field.
    const kindOf = (v: string) => (LINKEDIN_RE.test(v) ? 'LinkedIn profile' : EMAIL_RE.test(v) ? 'Email address' : '');
    const syncHint = (strict: boolean) => {
      const v = contact.value.trim();
      const kind = kindOf(v);
      const state = kind ? 'ok' : v && strict ? 'error' : '';
      hint.dataset.state = state;
      hint.textContent = kind ? `✓ ${kind}` : state === 'error' ? 'That should be a LinkedIn profile link or an email address.' : (hint.dataset.default ?? '');
      contact.setAttribute('aria-invalid', String(state === 'error'));
    };
    contact.addEventListener('input', () => syncHint(false));
    contact.addEventListener('blur', () => syncHint(true));

    let started = false;
    form.addEventListener('focusin', () => {
      if (started) return;
      started = true;
      track('referral_started', { role: page.dataset.role, self: isSelf() });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const raw = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      const self = isSelf();

      if (!kindOf(raw.contact?.trim() ?? '')) {
        syncHint(true);
        status.dataset.state = 'error';
        status.textContent = raw.contact?.trim() ? '' : 'Add a LinkedIn profile or an email address.';
        contact.focus();
        return;
      }

      button.disabled = true;
      status.dataset.state = 'pending';
      status.textContent = 'Sending…';

      try {
        const response = await fetch('/api/referral', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            role: page.dataset.role,
            self,
            contact: raw.contact,
            candidateName: self ? '' : raw.candidateName,
            why: raw.why,
            referrerName: raw.referrerName,
            referrerEmail: raw.referrerEmail,
            source,
            website: raw.website,
          }),
        });
        const body = await response.json().catch(() => ({}));
        if (!(response.ok && body.status === 'ok')) throw new Error(body.message ?? `HTTP ${response.status}`);

        track(self ? 'application_submitted' : 'referral_submitted', { role: page.dataset.role, source });

        // Keep who they are, so a second referral is one field again. After an
        // application, that is the contact they just gave us.
        form.reset();
        const me = self ? { name: '', email: EMAIL_RE.test(raw.contact.trim()) ? raw.contact.trim() : '' } : { name: raw.referrerName, email: raw.referrerEmail };
        (form.elements.namedItem('referrerName') as HTMLInputElement).value = me.name ?? '';
        (form.elements.namedItem('referrerEmail') as HTMLInputElement).value = me.email ?? '';
        setMode(self ? 'self' : 'other');
        syncHint(false);
        status.textContent = '';
        form.hidden = true;
        done.hidden = false;
        (done.querySelector('h2') as HTMLElement).focus();
      } catch (error) {
        // Say so, and give a way that still works, rather than losing the referral.
        status.dataset.state = 'error';
        status.innerHTML =
          `That didn't go through (${String((error as Error).message).slice(0, 80)}). ` +
          `Please email us at <a href="mailto:${MAILTO}">${MAILTO}</a>.`;
      } finally {
        button.disabled = false;
      }
    });

    // After either path, the next step is always a referral.
    done.querySelector('.refer-again')?.addEventListener('click', () => {
      setMode('other');
      done.hidden = true;
      form.hidden = false;
      contact.focus();
    });
  }
</script>

<style is:global>
  /* ── Layout ──
     One grid for hero and brief, with the form spanning both rows: on desktop
     it starts level with the headline and stays in view while people read the
     role. The warm band is a full-bleed layer behind the intro cell, so the
     card overlaps its edge whatever the copy's length. */
  .refer-page { overflow-x: clip; }
  .refer-top { position: relative; isolation: isolate; }
  .refer-grid { display: grid; }
  .refer-intro { position: relative; padding: 4.5rem 0 4rem; }
  .refer-intro::before {
    content: ''; position: absolute; z-index: -1;
    top: 0; bottom: 0; left: -100vw; right: -100vw;
    background: var(--tipm-warm-yellow);
  }
  .refer-brief { padding: 4rem 0 5rem; }
  .refer-aside { padding-top: 2.5rem; scroll-margin-top: 4rem; }

  @media (min-width: 992px) {
    .refer-grid { grid-template-columns: minmax(0, 1fr) 26rem; column-gap: 4.5rem; }
    .refer-intro { grid-column: 1; grid-row: 1; padding-bottom: 5rem; }
    .refer-brief { grid-column: 1; grid-row: 2; }
    .refer-aside { grid-column: 2; grid-row: 1 / span 2; padding: 3.5rem 0 5rem; }
    .refer-card { position: sticky; top: 4.5rem; }
    .refer-hero-cta { display: none !important; }
  }

  /* ── Hero ── */
  .refer-intro h1 { font-size: var(--fs-6xl); margin: 0.75rem 0 1.25rem; }
  .refer-lede { font-size: var(--fs-l); color: var(--fg-2); margin: 0 0 1.5rem; max-width: 36rem; }
  .refer-facts { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; }
  .refer-chip {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.35rem 0.85rem; border-radius: var(--radius-pill);
    background: var(--tipm-white); border: 1px solid var(--tipm-near-black);
    font-size: var(--fs-s); font-weight: var(--fw-medium); color: var(--fg-2);
  }
  .refer-chip svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .refer-hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  .refer-reassure { margin: 1rem 0 0; font-size: var(--fs-s); color: var(--fg-3); }

  /* ── Brief ── */
  .refer-brief h2 { font-size: var(--fs-4xl); margin: 0.5rem 0 1.5rem; }
  .refer-needs { display: grid; gap: 0.75rem; margin-bottom: 1.75rem; }
  .refer-need {
    display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start;
    padding: 1.1rem 1.25rem; border: 1px solid var(--tipm-outline); border-radius: var(--radius-lg);
  }
  .refer-need strong { display: block; font-weight: var(--fw-bold); }
  .refer-need span { color: var(--fg-3); }
  /* Hand-drawn marks (step numbers, checks): a slightly wobbly ink outline over
     a golden fill knocked off-register, the same offset language as the event
     cards. Fill (::before) and outline (::after) are both pseudo-elements, so
     the ink always sits on top of the golden. Each mark varies the offset and
     tilt through the --ink-* variables so no two look stamped. */
  .refer-step-n, .refer-tick, .refer-done-mark {
    --ink-dx: 5px; --ink-dy: 4px; --ink-fill-rot: 8deg; --ink-rot: -4deg; --ink-w: 2px;
    position: relative; isolation: isolate;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .refer-step-n::before, .refer-tick::before, .refer-done-mark::before,
  .refer-step-n::after, .refer-tick::after, .refer-done-mark::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
  }
  .refer-step-n::before, .refer-tick::before, .refer-done-mark::before {
    z-index: -1; background: var(--tipm-golden);
    border-radius: 45% 55% 48% 52% / 55% 45% 55% 45%;
    transform: translate(var(--ink-dx), var(--ink-dy)) rotate(var(--ink-fill-rot));
  }
  .refer-step-n::after, .refer-tick::after, .refer-done-mark::after {
    z-index: 1; border: var(--ink-w) solid var(--tipm-black);
    border-radius: 52% 48% 55% 45% / 47% 55% 45% 53%;
