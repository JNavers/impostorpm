---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

// Converted from compensation/index.html (the salary-compass copy, 79,233 B —
// the newer of the two twins that existed before the repos were folded together).
// Nav, footer and the shared chrome now come from the layout; .btn-cta and
// .section-golden were promoted to base.css because they are site components.
const POSTHOG = {
  token: 'phc_skjv4vgokxx9op9vtFHdjwNWuAA9VZZaPQ6wFguFvFcB',
  apiHost: 'https://eu.i.posthog.com',
  uiHost: 'https://eu.posthog.com',
};
---

<Base
  title="Product Manager Salary Calculator | Product Salary Compass"
  description="See where your Product Manager salary stands. Real data from 400+ PMs in 38 countries. Anonymous, 2 minutes, no email. Compare base, bonus, equity."
  image="/compensation-og.png"
>
  <Fragment slot="head">
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:image:alt" content="Product Salary Compass — Product Manager salary gauge with percentile breakdown." />

    {/* PostHog Cloud EU. The init script is served from /salary-compass/ so the
        tool and this landing page share one source of truth; it derives
        page_type from the path and disables itself on localhost. */}
    <script is:inline set:html={`window.TIPM_POSTHOG_CONFIG = window.TIPM_POSTHOG_CONFIG || ${JSON.stringify(POSTHOG)};`} />
    <script is:inline src="/salary-compass/posthog-init.js"></script>

    <script type="application/ld+json" is:inline>
        {
          "@context": "https://schema.org",
          "@type": "WebApplication",
          "name": "Product Salary Compass",
          "alternateName": "PM Salary Calculator",
          "url": "https://www.impostor.pm/salary-compass/",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web",
          "description": "Free salary calculator for Product Managers. Compare your base, bonus, and equity against real PM data, segmented by role, years of experience, country, and industry. Anonymous and email-optional.",
          "datePublished": "2026-05-19",
          "dateModified": "2026-05-19",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "EUR"
          },
          "provider": {
            "@type": "Organization",
            "name": "The Impostor PM",
            "url": "https://www.impostor.pm/"
          },
          "audience": {
            "@type": "Audience",
            "audienceType": "Product Managers"
          }
        }
        </script>
        <script type="application/ld+json" is:inline>
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          "name": "The Impostor PM",
          "alternateName": "TIPM",
          "url": "https://www.impostor.pm/",
          "logo": "https://www.impostor.pm/compensation-logo.svg",
          "description": "A community for Product Managers focused on real-world practice: salary transparency, peer mentoring, in-person Clubs, and live tools like the Product Salary Compass.",
          "knowsAbout": [
            "Product Management",
            "Product Manager salary",
            "Product Manager compensation",
            "PM career development",
            "Salary benchmarking"
          ],
          "sameAs": [
            "https://www.linkedin.com/company/impostorpm/"
          ]
        }
        </script>
        <script type="application/ld+json" is:inline>
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Is this really anonymous?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. No login, no name, no employer required. You can compare your salary without giving an email. Email is optional and only used if you ask to be notified."
              }
            },
            {
              "@type": "Question",
              "name": "Why should I trust the numbers?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "The data is self-reported by Product Managers, but we screen role titles so the sample stays PM-only, and we publish quartile counts so you can see the strength of each cohort. Cohorts with fewer than 30 data points are flagged."
              }
            },
            {
              "@type": "Question",
              "name": "Do I have to take the full survey to see my result?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. Comparison is instant. The optional 12-question survey unlocks the full breakdown (bonus, equity, perks) and contributors get first access to the interactive Dashboard when we hit 500 surveys."
              }
            },
            {
              "@type": "Question",
              "name": "What currencies do you support?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Enter in your local currency. We convert and store all amounts in EUR for comparison."
              }
            },
            {
              "@type": "Question",
              "name": "How is the Product Salary Compass different from Levels.fyi or Glassdoor?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "It is PM-only, focused on total compensation (base + bonus + equity + perks), uses real reported pay rather than employer-pulled job-board ranges, and the methodology is published in plain English."
              }
            },
            {
              "@type": "Question",
              "name": "Where does the data go?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "A private dataset. We publish aggregated medians and quartiles only. No row-level export, ever. No employer information is collected."
              }
            }
          ]
        }
        </script>
        <script type="application/ld+json" is:inline>
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "The Impostor PM",
              "item": "https://www.impostor.pm/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Product Salary Compass",
              "item": "https://www.impostor.pm/compensation/"
            }
          ]
        }
        </script>
  </Fragment>

  <section class="section-warm" style="padding: 5rem 0 4rem;">
      <div class="container">
          <div class="row align-items-center">
              <div class="col-lg-7 mb-5 mb-lg-0">
                  <span class="eyebrow-chip">Product Salary Compass · Portugal</span>
                  <h1 class="hero-heading">Know exactly where your <span class="scribble-underline">PM salary</span> stands.</h1>
                  <p class="hero-subtitle">Curious? Preparing a raise? Weighing an offer? The Compass tells you if your number is below, at, or above market — against real Product Managers, not job-board ranges.</p>
                  <div class="hero-cta-row">
                      <a href="/salary-compass/#start" class="btn-cta">Analyse my salary</a>
                      <a href="#how-it-works" class="btn-cta-dark">How it works</a>
                  </div>
                  <div class="hero-counter-line" id="hero-counter-line">
                      <span class="dot-live"></span>
                      <span><strong id="hero-counter-current">0</strong> PMs have shared their numbers.</span>
                  </div>
              </div>

              <div class="col-lg-5">
                  <div class="hero-mockup" aria-hidden="true">
                      <div class="hero-mockup-head">
                          <span><span class="mockup-dot d-inline-block mr-1" style="vertical-align:middle;"></span>Your Result</span>
                          <span class="hero-mockup-pill">Top 38%</span>
                      </div>
                      <div class="hero-mockup-amount">€68,000</div>
                      <div class="hero-mockup-cohort">Senior PM · 5–8 yrs · Portugal · SaaS</div>

                      <div class="gauge-wrap">
                          <svg width="100%" viewBox="0 0 240 150" xmlns="http://www.w3.org/2000/svg" style="max-width:280px;">
                              <defs>
                                  <linearGradient id="gaugeFill" x1="0%" y1="0%" x2="100%" y2="0%">
                                      <stop offset="0%" stop-color="#ffe680"/>
                                      <stop offset="100%" stop-color="#ffc600"/>
                                  </linearGradient>
                              </defs>
                              <!-- background arc (radius 100, center 120,120) -->
                              <path d="M20 120 A100 100 0 0 1 220 120" stroke="#f0f0f0" stroke-width="14" fill="none" stroke-linecap="round"/>
                              <!-- filled arc to 62% (Top 38% badge) — endpoint on same circle -->
                              <path d="M20 120 A100 100 0 0 1 156.8 27" stroke="url(#gaugeFill)" stroke-width="14" fill="none" stroke-linecap="round"/>
                              <!-- needle at 62% (rotation = (62-50)*1.8 = 21.6°) -->
                              <g transform="rotate(21.6 120 120)">
                                  <line x1="120" y1="120" x2="120" y2="40" stroke="#1e1e1e" stroke-width="3" stroke-linecap="round"/>
                                  <circle cx="120" cy="120" r="6" fill="#1e1e1e"/>
                              </g>
                              <!-- tick labels -->
                              <text x="20" y="142" font-size="10" font-family="Inter" fill="#999" text-anchor="middle">€0</text>
                              <text x="220" y="142" font-size="10" font-family="Inter" fill="#999" text-anchor="middle">€130k</text>
                          </svg>
                      </div>

                      <div class="mockup-bars">
                          <div class="mockup-bar-row">
                              <span class="bar-label">Base</span>
                              <span class="bar-track">
                                  <span class="bar-fill" style="width:62%;"></span>
                                  <span class="bar-marker" style="left:71%;"></span>
                              </span>
                              <span class="bar-value">€60k</span>
                          </div>
                          <div class="mockup-bar-row">
                              <span class="bar-label">Bonus</span>
                              <span class="bar-track">
                                  <span class="bar-fill" style="width:35%;"></span>
                                  <span class="bar-marker" style="left:40%;"></span>
                              </span>
                              <span class="bar-value">€6k</span>
                          </div>
                          <div class="mockup-bar-row">
                              <span class="bar-label">Equity</span>
                              <span class="bar-track">
                                  <span class="bar-fill" style="width:18%;"></span>
                                  <span class="bar-marker" style="left:25%;"></span>
                              </span>
                              <span class="bar-value">€2k</span>
                          </div>
                      </div>

                      <div class="mockup-chip-row">
                          <span class="mockup-chip">Senior PM</span>
                          <span class="mockup-chip">5–8 yrs</span>
                          <span class="mockup-chip">Portugal</span>
                          <span class="mockup-chip">SaaS</span>
                      </div>
                  </div>
              </div>
          </div>
      </div>
  </section>

  <!-- ════════════ 2 · SOCIAL PROOF STRIP ════════════ -->
  <section class="strip" style="display: none;">
      <div class="container">
          <div class="strip-grid">
              <div class="strip-cell">
                  <span class="strip-value" id="strip-count">400+</span>
                  <span class="strip-label">Contributors</span>
              </div>
              <div class="strip-cell">
                  <span class="strip-value">38</span>
                  <span class="strip-label">Countries</span>
              </div>
              <div class="strip-cell">
                  <span class="strip-value">100%</span>
                  <span class="strip-label">Anonymous</span>
              </div>
              <div class="strip-cell">
                  <span class="strip-value">0</span>
                  <span class="strip-label">Recruiters</span>
              </div>
          </div>
      </div>
  </section>

  <!-- ════════════ 2.5 · WHEN TO OPEN IT ════════════ -->
  <section class="section-warm section-pad-lg">
      <div class="container">
          <div class="text-center mb-5" style="max-width:760px; margin-left:auto; margin-right:auto;">
              <span class="section-eyebrow">When to open it</span>
              <h2 class="h2-display">PMs run the Compass for <span class="scribble-underline">three reasons.</span></h2>
              <p class="lede">It's a salary analysis tool — for the moments when guessing costs you money.</p>
          </div>

          <div class="row">
              <div class="col-md-4 mb-4 mb-md-0">
                  <div class="output-card">
                      <span class="output-status now">Reality check</span>
                      <h3 class="output-title">Out of curiosity</h3>
                      <p class="output-desc">Top quartile, mid-pack, or underpaid? Get an honest read against real PMs in your cohort — no email, no recruiter spin.</p>
                  </div>
              </div>
              <div class="col-md-4 mb-4 mb-md-0">
                  <div class="output-card">
                      <span class="output-status soon">Raise prep</span>
                      <h3 class="output-title">Before asking for a raise</h3>
                      <p class="output-desc">Walk in with a percentile, not a guess. See how far below market you actually are — and by how much.</p>
                  </div>
              </div>
              <div class="col-md-4">
                  <div class="output-card">
                      <span class="output-status recurring">Offer review</span>
                      <h3 class="output-title">Weighing an offer</h3>
                      <p class="output-desc">A number just landed in your inbox. Is it market, above, or a lowball? Check before you accept, counter, or walk away.</p>
                  </div>
              </div>
          </div>
      </div>
  </section>

  <!-- ════════════ 3 · THE PROBLEM ════════════ -->
  <section class="section-white section-pad-lg">
      <div class="container">
          <div class="text-center mb-5" style="max-width:760px; margin-left:auto; margin-right:auto;">
              <span class="section-eyebrow">The data problem</span>
              <h2 class="h2-display">Glassdoor, LinkedIn, that one Reddit thread. <span class="scribble-underline">All wrong.</span></h2>
              <p class="lede">Salary data for PMs is broken in three ways. The Compass fixes each one.</p>
          </div>

          <div class="row">
              <div class="col-md-4 mb-4 mb-md-0">
                  <div class="d-flex align-items-start" style="gap:1rem;">
                      <span class="num-circle">1</span>
                      <div>
                          <h3 style="font-size:1.25rem; margin-bottom:.5rem;">Aggregated to mush</h3>
                          <p style="color:var(--text-muted); line-height:1.65; margin:0;">Median "PM salary" lumps a 1-year associate in Lisbon with a 12-year Director in Berlin. Useless for you.</p>
                      </div>
                  </div>
              </div>
              <div class="col-md-4 mb-4 mb-md-0">
                  <div class="d-flex align-items-start" style="gap:1rem;">
                      <span class="num-circle">2</span>
                      <div>
                          <h3 style="font-size:1.25rem; margin-bottom:.5rem;">Pulled from listings, not paychecks</h3>
                          <p style="color:var(--text-muted); line-height:1.65; margin:0;">Job-board ranges are negotiation anchors employers set. Real take-home pay looks different.</p>
                      </div>
                  </div>
              </div>
              <div class="col-md-4">
                  <div class="d-flex align-items-start" style="gap:1rem;">
                      <span class="num-circle">3</span>
                      <div>
                          <h3 style="font-size:1.25rem; margin-bottom:.5rem;">No bonus, no equity, no truth</h3>
                          <p style="color:var(--text-muted); line-height:1.65; margin:0;">Base is half the story. The Compass collects total comp: base, bonus, equity, and perks.</p>
                      </div>
                  </div>
              </div>
          </div>
      </div>
  </section>

  <!-- ════════════ 4 · THE PRODUCT ════════════ -->
  <section class="section-warm section-pad-lg">
      <div class="container">
          <div class="text-center mb-5" style="max-width:760px; margin-left:auto; margin-right:auto;">
              <span class="section-eyebrow">The Tool</span>
              <h2 class="h2-display">A salary compass, not a salary report.</h2>
              <p class="lede">Three things it does that a PDF can't.</p>
          </div>

          <div class="feature-row">
              <div class="feature-text">
                  <div class="feature-eyebrow">01 · Compare</div>
                  <h3 class="feature-title">Instant percentile</h3>
                  <p class="feature-desc">Type your number. See where you sit against 400+ Product Managers in seconds. No form to fill, no email required.</p>
              </div>
              <div class="feature-visual">
                  <div class="mini-card">
                      <div class="mini-card-label">Your percentile</div>
                      <div class="mini-perc-row">
                          <span class="mini-perc-bar"><span class="fill" style="width:62%;"></span></span>
                          <span class="mini-perc-val">Top 38%</span>
                      </div>
                      <div style="font-size:.75rem; color:var(--text-muted); margin-top:.75rem;">Updates as you type.</div>
                  </div>
              </div>
          </div>

          <div class="feature-row reverse">
              <div class="feature-text">
                  <div class="feature-eyebrow">02 · Filter</div>
                  <h3 class="feature-title">Filtered comparison</h3>
                  <p class="feature-desc">Slice by role, years of experience, country, industry, company size, and work setup. Find your real cohort, not a fake industry average.</p>
              </div>
              <div class="feature-visual">
                  <div class="mini-card">
                      <div class="mini-card-label">Cohort filters</div>
                      <div class="mini-chips">
                          <span class="mini-chip is-on">Senior PM</span>
                          <span class="mini-chip is-on">5–8 yrs</span>
                          <span class="mini-chip is-on">Portugal</span>
                          <span class="mini-chip is-on">SaaS</span>
                          <span class="mini-chip">Remote</span>
                          <span class="mini-chip">50–250 FTE</span>
                      </div>
                  </div>
              </div>
          </div>

          <div class="feature-row">
              <div class="feature-text">
                  <div class="feature-eyebrow">03 · Unlock</div>
                  <h3 class="feature-title">Unlocked breakdowns</h3>
                  <p class="feature-desc">Want bonus medians, equity prevalence, and perk values? Complete the 2-minute anonymous survey and the full dataset opens for you.</p>
              </div>
              <div class="feature-visual">
                  <div class="mini-card">
                      <div class="mini-lock-row">
                          <span class="label">Base salary</span>
                          <span class="state unlocked">Unlocked</span>
                      </div>
                      <div class="mini-lock-divider"></div>
                      <div class="mini-lock-row">
                          <span class="label">Bonus medians</span>
                          <span class="state locked">Locked</span>
                      </div>
                      <div class="mini-lock-divider"></div>
                      <div class="mini-lock-row">
                          <span class="label">Equity prevalence</span>
                          <span class="state locked">Locked</span>
                      </div>
                      <div class="mini-lock-divider"></div>
                      <div class="mini-lock-row">
                          <span class="label">Perks &amp; benefits</span>
                          <span class="state locked">Locked</span>
                      </div>
                  </div>
              </div>
          </div>

          <div class="text-center mt-5">
              <a href="/salary-compass/#start" class="btn-cta">Open the Compass</a>
          </div>
      </div>
  </section>

  <!-- ════════════ 5 · HOW IT WORKS ════════════ -->
  <section id="how-it-works" class="section-white section-pad-lg">
      <div class="container" style="max-width:760px;">
          <div class="text-center mb-5">
              <h2 class="h2-display">Four steps. Two minutes. Zero friction.</h2>
          </div>
          <div class="timeline">
              <div class="timeline-item">
                  <span class="timeline-dot"></span>
                  <div class="d-flex flex-column flex-md-row align-items-md-baseline mb-1" style="gap:.65rem;">
                      <span class="timeline-time">0:15</span>
                      <h3 class="timeline-step-title">Enter your numbers</h3>
                  </div>
                  <p style="color:var(--text-muted); margin-bottom:0;">Role, years of experience, country, and base salary. Use your local currency — we handle the conversion.</p>
              </div>
              <div class="timeline-item">
                  <span class="timeline-dot"></span>
                  <div class="d-flex flex-column flex-md-row align-items-md-baseline mb-1" style="gap:.65rem;">
                      <span class="timeline-time">0:30</span>
                      <h3 class="timeline-step-title">See your percentile</h3>
                  </div>
                  <p style="color:var(--text-muted); margin-bottom:0;">An instant gauge tells you exactly where you stand against PMs in your cohort. Top 38% or bottom 12% — whichever it is.</p>
              </div>
              <div class="timeline-item">
                  <span class="timeline-dot"></span>
                  <div class="d-flex flex-column flex-md-row align-items-md-baseline mb-1" style="gap:.65rem;">
                      <span class="timeline-time">1:30</span>
                      <h3 class="timeline-step-title">Optional: full survey</h3>
                  </div>
                  <p style="color:var(--text-muted); margin-bottom:0;">Twelve anonymous questions on bonus, equity, perks, and work setup. Unlocks the full dataset and your name on the contributor list.</p>
              </div>
              <div class="timeline-item">
                  <span class="timeline-dot"></span>
                  <div class="d-flex flex-column flex-md-row align-items-md-baseline mb-1" style="gap:.65rem;">
                      <span class="timeline-time">2:00</span>
                      <h3 class="timeline-step-title">Share or save</h3>
                  </div>
                  <p style="color:var(--text-muted); margin-bottom:0;">Share your result as a link or image, or email it to yourself. Your data lives in your browser until you choose to send it.</p>
              </div>
          </div>
      </div>
  </section>

  <!-- ════════════ 6 · WHAT YOU'LL SEE ════════════ -->
  <section class="section-dark section-pad-lg">
      <div class="container">
          <div class="text-center mb-5" style="max-width:680px; margin-left:auto; margin-right:auto;">
              <h2 class="h2-display" style="color:var(--white);">This is <span class="scribble-underline">your result.</span></h2>
              <p class="lede" style="color:rgba(255,255,255,.7);">A preview of what the Compass returns. The numbers move with your filters.</p>
          </div>

          <div class="result-card">
              <div class="blob"></div>
              <div class="result-card-head">
                  <span class="result-card-eyebrow">Your Result</span>
                  <span class="result-card-pill">Top 38%</span>
              </div>
              <div class="result-amount">€68,000</div>
              <div class="result-meta">Senior PM · 5–8 yrs · Portugal · SaaS</div>

              <div class="gauge-wrap">
                  <svg width="100%" viewBox="0 0 240 150" xmlns="http://www.w3.org/2000/svg" style="max-width:340px;" aria-hidden="true">
                      <defs>
                          <linearGradient id="gaugeFillDark" x1="0%" y1="0%" x2="100%" y2="0%">
                              <stop offset="0%" stop-color="#ffe680"/>
                              <stop offset="100%" stop-color="#ffc600"/>
                          </linearGradient>
                      </defs>
                      <path d="M20 120 A100 100 0 0 1 220 120" stroke="rgba(255,255,255,.08)" stroke-width="14" fill="none" stroke-linecap="round"/>
                      <path d="M20 120 A100 100 0 0 1 156.8 27" stroke="url(#gaugeFillDark)" stroke-width="14" fill="none" stroke-linecap="round"/>
                      <g transform="rotate(21.6 120 120)">
                          <line x1="120" y1="120" x2="120" y2="40" stroke="#ffffff" stroke-width="3" stroke-linecap="round"/>
                          <circle cx="120" cy="120" r="6" fill="#ffffff"/>
                      </g>
                      <text x="20" y="142" font-size="10" font-family="Inter" fill="rgba(255,255,255,.5)" text-anchor="middle">€0</text>
                      <text x="220" y="142" font-size="10" font-family="Inter" fill="rgba(255,255,255,.5)" text-anchor="middle">€130k</text>
                  </svg>
              </div>

              <div class="result-bars">
                  <div class="result-bar-row">
                      <span class="label">Base</span>
                      <span class="track">
                          <span class="fill" style="width:62%;"></span>
                          <span class="marker" style="left:71%;"></span>
                      </span>
                      <span class="val">€60k</span>
                  </div>
                  <div class="result-bar-row">
                      <span class="label">Bonus</span>
                      <span class="track">
                          <span class="fill" style="width:35%;"></span>
                          <span class="marker" style="left:40%;"></span>
                      </span>
                      <span class="val">€6k</span>
                  </div>
                  <div class="result-bar-row">
                      <span class="label">Equity</span>
                      <span class="track">
                          <span class="fill" style="width:18%;"></span>
                          <span class="marker" style="left:25%;"></span>
                      </span>
                      <span class="val">€2k</span>
                  </div>
              </div>

              <div class="result-chip-row">
                  <span class="result-chip">Senior PM</span>
                  <span class="result-chip">5–8 yrs</span>
                  <span class="result-chip">Portugal</span>
                  <span class="result-chip">SaaS</span>
              </div>

