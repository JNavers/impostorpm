<script is:inline>
(function() {
    /* ── Live counter from Apps Script ──
     * Two metrics in play:
     *   - SOCIAL_PROOF_METRIC ('total' = historical + submissions) → hero line, strip count.
     *   - MILESTONE_METRIC ('surveys') → contrib block "of 500" + progress card (Dashboard unlock).
     * Flip MILESTONE_METRIC to 'submissions' if the surveys count alone is too low to motivate.
     */
    var SHEETS_WEBHOOK = 'https://script.google.com/macros/s/AKfycbxW5SPrFA7aT4HKPi-ASoFFjsO4rU9ajps6fUhvezQdQyeAwnrsKWMk02Kg5SamllZ4gg/exec';
    var SOCIAL_PROOF_METRIC = 'total';
    var MILESTONE_METRIC = 'surveys';
    var COUNTER_GOAL = 500;
    var COUNTER_MIN_VISIBLE = 50;          // hide hero counter when below this threshold

    function renderCounter(counts) {
        if (!counts || typeof counts !== 'object') return;
        var socialProof = Number(counts[SOCIAL_PROOF_METRIC]);
        var milestone = Number(counts[MILESTONE_METRIC]);
        if (!isFinite(socialProof) || socialProof < 0) socialProof = 0;
        if (!isFinite(milestone) || milestone < 0) milestone = 0;

        var stripEl = document.getElementById('strip-count');
        var contribEl = document.getElementById('contrib-count');
        var heroEl = document.getElementById('hero-counter-current');
        var heroLine = document.getElementById('hero-counter-line');
        var pFill = document.getElementById('contrib-progress-fill');
        var pCount = document.getElementById('contrib-progress-count');
        var pPct = document.getElementById('contrib-progress-pct');

        if (stripEl) stripEl.textContent = socialProof;
        if (contribEl) contribEl.textContent = milestone;
        if (pCount) pCount.textContent = milestone;

        var capped = Math.min(milestone, COUNTER_GOAL);
        var pct = Math.max(0, Math.min(100, Math.round((capped / COUNTER_GOAL) * 100)));
        if (pFill) pFill.style.width = pct + '%';
        if (pPct) pPct.textContent = pct + '%';

        if (socialProof >= COUNTER_MIN_VISIBLE) {
            if (heroEl) heroEl.textContent = socialProof;
            if (heroLine) heroLine.classList.add('is-visible');
        }
    }

    function fetchCounter() {
        var host = window.location.hostname;
        var isLocalhost = ['localhost', '127.0.0.1', '0.0.0.0'].indexOf(host) !== -1;
        if (isLocalhost) {
            renderCounter({ submissions: 80, surveys: 50, historical: 762, total: 842 });
            return;
        }
        var url = SHEETS_WEBHOOK + '?action=count';
        var network = fetch(url, { redirect: 'follow' }).then(function(res) { return res.json(); });
        var timeout = new Promise(function(_, reject) {
            setTimeout(function() { reject(new Error('timeout')); }, 6000);
        });
        Promise.race([network, timeout])
            .then(function(data) {
                if (!data) return;
                renderCounter(data);
            })
            .catch(function() { /* counter rows stay at defaults */ });
    }

    /* ── FAQ accordion ── */
    function initFaq() {
        var buttons = document.querySelectorAll('.faq-q');
        buttons.forEach(function(btn) {
            btn.addEventListener('click', function() {
                var expanded = btn.getAttribute('aria-expanded') === 'true';
                var panelId = btn.getAttribute('aria-controls');
                var panel = document.getElementById(panelId);
                btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
                if (panel) panel.hidden = expanded;
            });
        });
    }

    /* ── PostHog tracking on CTA clicks (graceful no-op if PostHog absent) ── */
    function initTracking() {
        document.querySelectorAll('a[href^="/salary-compass/"]').forEach(function(a) {
            a.addEventListener('click', function() {
                if (window.posthog && typeof window.posthog.capture === 'function') {
                    var section = a.closest('section');
                    window.posthog.capture('compass_landing_cta_clicked', {
                        label: a.textContent.trim(),
                        destination: a.getAttribute('href'),
                        section: section ? (section.id || section.className.split(' ')[0]) : 'unknown'
                    });
                }
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            fetchCounter();
            initFaq();
            initTracking();
        });
    } else {
        fetchCounter();
        initFaq();
        initTracking();
    }
})();
</script>

