---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const walkaway = [
  {
    icon: 'eye' as const,
    title: 'Clarity on your next step',
    body: 'Stop spinning your wheels. Leave with a concrete action plan for your specific work challenge.',
  },
  {
    icon: 'people-group' as const,
    title: 'A peer advisory board',
    body: "Connect deeply with 9 other high-caliber PMs. This isn't networking; it's bonding through shared struggle.",
  },
  {
    icon: 'comments' as const,
    title: 'Unbiased feedback',
    body: "Your team can't tell you the whole truth. Your boss has an agenda. We have neither. Just honest mirroring.",
  },
  {
    icon: 'bolt' as const,
    title: 'Renewed confidence',
    body: 'Combat impostor syndrome by realizing everyone else is figuring it out too. Leave energized.',
  },
];

const features = [
  { icon: 'users' as const, title: 'Tiny cohorts', body: '10 PMs per session. No hiding in the back row. Everyone contributes.' },
  { icon: 'lock' as const, title: 'Chatham House Rule', body: 'What happens in the Huddle stays in the Huddle. Total psychological safety.' },
  { icon: 'award' as const, title: 'Senior Facilitation', body: 'Led by CPOs and Heads of Product who have actually done the job.' },
  { icon: 'target' as const, title: 'Real Scenarios', body: 'We work through your actual current blockers, not hypothetical case studies.' },
];

const schedule = [
  { time: '09:00', title: 'Check-in & Context Setting', body: 'Coffee, introductions, and establishing psychological safety rules. We define the "Problem Statements" for the day.' },
  { time: '09:30', title: 'Hot Seats (Round 1)', body: 'Individual deep dives. One person presents a challenge, the group dissects it with Socratic questioning.' },
  { time: '10:45', title: 'Bio Break & Networking', body: 'Casual conversation to decompress and connect one-on-one.' },
  { time: '11:00', title: 'Hot Seats (Round 2) & Synthesis', body: 'Second round of challenges followed by a guided synthesis of key takeaways and action items.' },
  { time: '12:00', title: 'Close', body: 'Leave with clarity.' },
];

const fit = [
  { n: 1, title: 'You are a Senior PM or above', body: 'You know the basics. You aren’t looking for "How to write a user story." You’re dealing with organizational complexity.' },
  { n: 2, title: 'You feel stuck or isolated', body: "You're the only PM in your startup, or you feel like you can't be vulnerable with your current team." },
  { n: 3, title: 'You are willing to share', body: 'This is participatory. You must be willing to bring a real problem to the table and give feedback to others.' },
  { n: 4, title: 'You value distinct perspectives', body: 'You understand that the answer isn’t always "it depends," but finding the context that matters.' },
];

const session = [
  { label: 'When', value: 'March 28', sub: '09:00 - 12:00' },
  { label: 'Where', value: 'Porto', sub: 'Pixelmatters HQ' },
  { label: 'Price', value: '€39', sub: 'Founding Rate' },
  { label: 'Seats', value: '10 PMs', sub: null },
];
---

<Base
  title="Huddle - The Impostor PM"
  description="Small-group mentoring for Product Managers. Apply for the next Huddle."
>
  <!-- ════════════ HERO ════════════ -->
  <header class="section-warm" style="padding: 5rem 0 4rem;">
    <div class="container">
      <div class="row align-items-center" style="min-height: 480px;">
        <div class="col-lg-5 order-2 order-lg-1 hero-text-col">
          <h1 style="font-size:4.5rem; line-height:.92; letter-spacing:-.04em;" class="mb-4">
            Huddle<span style="color:var(--golden);">.</span>
          </h1>
          <h2 style="font-size:1.5rem; font-weight:500; line-height:1.3; color:#333;" class="mb-3">
            Small-group mentoring for Product Managers who want the truth.
          </h2>
          <p style="font-size:1.0625rem; color:#666; line-height:1.65;" class="mb-5">
            Intimate, expert-led sessions designed to help you navigate the unspoken challenges of product leadership. No fluff. Just real talk.
          </p>
          <div class="d-flex flex-column flex-sm-row" style="gap:.75rem;">
            <a href="#march-edition" class="btn btn-accent" style="white-space:nowrap;">Apply for March 28</a>
            <a href="#format" class="btn btn-outline-custom" style="white-space:nowrap;">
              <span>How it works</span>
              <Icon name="arrow-down" size="0.8rem" class="ml-2 inline-arrow" />
            </a>
          </div>
        </div>
        <div class="col-lg-7 order-1 order-lg-2 mb-4 mb-lg-0 hero-art" style="padding-left: 12rem;">
          <svg viewBox="0 0 500 500" fill="none" stroke="#000" stroke-width="2" aria-hidden="true" style="overflow: visible; width:100%; max-width:32rem; height:auto;">
            <circle fill="#ffc600" stroke="none" opacity=".2" cx="280" cy="200" r="45"></circle>
            <path d="M436.5 289.5c-48.4 4.5-92.4-23.9-138.8-37.5-47.5-13.9-97.9-17-145.4-3.5-35.9 10.2-68.9 29.8-95.3 56.4-13.7 13.8-25.9 29.3-35.1 46.5-12.2 22.9-18.4 49.3-15.3 75.3 3.4 28.5 17.5 55.4 39.5 74.3 26.6 22.8 63.6 30.6 97.8 24.3 32.5-6 61.4-25.8 83.3-51 25.1-28.8 38.3-67.4 39.8-105.7 1.4-36.9-10.4-74.1-33.8-103.2-22.1-27.4-52.9-47.6-86.7-56.9-35.6-9.8-74.6-6.4-108.6 9.4-32.2 14.9-59.5 40.5-77.9 71.6-17.1 28.8-24.3 63.1-20.9 96.6 2.5 25.4 11.2 50.1 25.7 71.9 16.3 24.5 39.1 44.5 66.5 55.9 29.3 12.2 63.2 13.9 93.9 4.7 32.9-9.8 61.5-33 81.9-60.8 22.2-30.2 32.9-68.4 30.5-105.7-2-32.3-13.1-64-32.2-90.1-20.5-28.1-49.4-49.8-82.6-61.2-35.6-12.2-76.1-10.5-111.4 4.9-33.8 14.7-62.8 40.8-82.5 72.8-18.4 29.9-26.4 66.1-23.2 101.3 2.3 26.2 10.9 51.9 25.3 74.6 15.6 24.6 37.8 44.7 64.6 56.5 27.6 12.2 59.8 14.3 89.2 5.9 31.7-9 59.7-30.8 79.9-57.2 22-28.7 33.1-65.4 31.5-101.4-1.4-31.5-11.6-62.7-29.6-88.7-19.5-28.1-47.4-50.5-79.6-62.8-35.2-13.5-76.1-13-111.9 1.5-35.3 14.3-66.3 39.8-87.8 71.7-20.2 29.9-29.4 66.7-26.6 102.6 1.9 25.4 9.9 50.5 23.3 72.9" transform="translate(50, 0) scale(0.85)"></path>
          </svg>
        </div>
      </div>
    </div>
  </header>

  <!-- ════════════ NOT A TALK ════════════ -->
  <section class="section-white section-pad-lg">
    <div class="container">
      <div class="text-center mb-5">
        <h2 style="font-size:2.25rem;">Not a talk. Not a workshop.<br /><span class="scribble-underline">A Huddle.</span></h2>
        <p style="font-size:1.125rem; color:#666;" class="mt-3">The missing piece in your professional growth stack.</p>
      </div>
      <div class="row align-items-center">
        <div class="col-md-6 mb-4 mb-md-0">
          {features.map((f, i) => (
            <div class={`d-flex${i < features.length - 1 ? ' mb-4' : ''}`}>
              <div class="icon-box mr-3"><Icon name={f.icon} size="1.125rem" /></div>
              <div>
                <h3 style="font-size:1.25rem;" class="mb-1">{f.title}</h3>
                <p style="color:#666;">{f.body}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="col-md-6">
          <div class="why-card">
            <div class="why-card-blob"></div>
            <div style="position:relative; z-index:1;">
              <h3 style="font-size:1.375rem;" class="mb-3">Why Huddle exists</h3>
              <p style="color:#666;" class="mb-3">
                Most PM conferences are about inspiration. Most courses are about frameworks. Huddle is about <strong style="color:var(--black);">application</strong>. It's the space between theory and practice where you figure out how to actually influence that stubborn stakeholder.
              </p>
              <a href="#march-edition" class="why-card-link">Check upcoming dates →</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════ PHILOSOPHY ════════════ -->
  <section class="section-dark section-pad-lg">
    <div class="container text-center" style="max-width:720px;">
      <h2 style="font-size:3rem; line-height:1.05;" class="mb-4">Because experience<br /><span style="color:#666;">matters.</span></h2>
      <div style="max-width:600px; margin:0 auto;">
        <p style="font-size:1.125rem; color:#ccc; line-height:1.7;" class="mb-3">You can read every book on product discovery. You can master SQL. You can write perfect PRDs.</p>
        <p style="font-size:1.125rem; color:#ccc; line-height:1.7;" class="mb-4">But the real job happens in the messy middle. It happens in the 1:1s, the difficult prioritization calls, and the moments of self-doubt.</p>
        <p style="font-size:1.5rem; font-weight:500; color:var(--white);">You don't just reflect. You recalibrate.</p>
      </div>
      <div class="mt-5">
        <a href="#march-edition" class="btn btn-accent btn-lg-custom">Apply Now</a>
      </div>
    </div>
  </section>

  <!-- ════════════ WHAT YOU WALK AWAY WITH ════════════ -->
  <section class="section-white section-pad-lg">
    <div class="container">
      <h2 style="font-size:2.25rem;" class="mb-5">What you walk away with</h2>
      <div class="walkaway-grid">
        <div class="row no-gutters">
          {walkaway.map((item) => (
            <div class="col-md-6">
              <div class="walkaway-cell">
                <Icon name={item.icon} size="2rem" class="walkaway-icon mb-3" />
                <h3 style="font-size:1.375rem;" class="mb-2">{item.title}</h3>
                <p style="color:#666; line-height:1.65;">{item.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════ THE FORMAT ════════════ -->
  <section id="format" class="section-warm section-pad-lg">
    <div class="container" style="max-width:720px;">
      <h2 style="font-size:2.25rem;" class="text-center mb-5">The Format</h2>
      <div class="timeline">
        {schedule.map((slot, i) => (
          <div class="timeline-item" style={i === schedule.length - 1 ? 'margin-bottom:0;' : undefined}>
            <span class="timeline-dot"></span>
            <div class="d-flex flex-column flex-md-row align-items-md-baseline mb-1" style="gap:.5rem;">
              <span class="timeline-time">{slot.time}</span>
              <h3 style="font-size:1.25rem; margin-bottom:0;">{slot.title}</h3>
            </div>
            <p style={`color:#666;${i === schedule.length - 1 ? ' margin-bottom:0;' : ''}`}>{slot.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════ HUDDLE IS FOR YOU IF ════════════ -->
  <section class="section-white section-pad-lg">
    <div class="container text-center" style="max-width:960px;">
      <h2 style="font-size:2.75rem; line-height:1.1;">Huddle is for you if:</h2>
      <div class="row mt-5">
        {fit.map((item, i) => (
          <div class={`col-md-6${i < 2 ? ' mb-4' : i === 2 ? ' mb-4 mb-md-0' : ''}`}>
            <div class="huddle-fit-card text-left">
              <div class="d-flex">
                <div class="num-circle mr-3 mt-1">{item.n}</div>
                <div>
                  <h3 style="font-size:1.25rem;" class="mb-1">{item.title}</h3>
                  <p style="color:#666; margin-bottom:0;">{item.body}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════ MARCH EDITION ════════════ -->
  <section id="march-edition" class="section-warm section-pad-lg">
    <div class="container" style="max-width:720px;">
      <div class="pricing-card p-4 p-md-5">
        <span class="pricing-badge">Next Session</span>
        <h2 style="font-size:2rem;" class="mb-4 mt-2">March Edition</h2>
        <div class="row mb-4">
          {session.map((cell, i) => (
            <div class={`col-6 col-md-3${i < 2 ? ' mb-3 mb-md-0' : ''}`}>
              <span class="session-label d-block mb-1">{cell.label}</span>
              <p class="session-value">{cell.value}</p>
              {cell.sub && <p class="session-sub">{cell.sub}</p>}
            </div>
          ))}
        </div>
        <div class="d-flex flex-column flex-sm-row align-items-sm-center" style="gap:.75rem;">
          <a href="https://luma.com/fpz1ptln" target="_blank" rel="noreferrer" class="btn btn-dark btn-lg-custom">Secure your spot</a>
          <p style="font-size:.875rem; color:#888; font-style:italic; margin-bottom:0;">100% money-back guarantee if you don't find value.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Page-specific only. Astro scopes this block, so nothing here can leak into
     another page — which is what makes it safe to leave a rule behind rather
     than force it into base.css before it is proven shared. */

  .inline-arrow { width: .8rem; height: .8rem; display: inline-block; vertical-align: -1px; }

  /* ── "Why Huddle exists" card ── */
  .why-card {
    background: var(--tipm-light-gray);
    border-radius: var(--radius-xl);
    padding: 2rem 2.5rem;
    position: relative;
    overflow: hidden;
  }
  .why-card-blob {
    position: absolute;
    top: -2rem; right: -2rem;
    width: 8rem; height: 8rem;
    background: var(--tipm-golden);
    opacity: .2;
    border-radius: 50%;
    filter: blur(40px);
  }
  .why-card-link {
    color: var(--tipm-black);
    font-weight: var(--fw-bold);
    text-decoration: underline;
    text-decoration-color: var(--tipm-golden);
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  /* ── Timeline ── */
  .timeline { position: relative; padding-left: 2.5rem; }
  .timeline::before {
    content: "";
    position: absolute;
    left: calc(1.25rem - 1.5px); top: 0; bottom: 0;
    width: 3px;
    background: var(--tipm-golden-40);
  }
  .timeline-item { position: relative; margin-bottom: 2.5rem; }
  .timeline-dot {
    position: absolute;
    left: -1.875rem; top: .25rem;
    width: 1.25rem; height: 1.25rem;
    border-radius: 50%;
    background: var(--tipm-white);
    border: 4px solid var(--tipm-golden);
  }
  .timeline-time {
    font-weight: var(--fw-bold);
    color: var(--tipm-golden);
    font-size: var(--fs-l);
    font-variant-numeric: tabular-nums;
  }

  /* ── Walk-away grid ── */
  .walkaway-grid { border: 1px solid var(--tipm-outline); border-radius: var(--radius-xl); overflow: hidden; }
  .walkaway-cell { padding: 2.5rem; background: var(--tipm-white); }
  .walkaway-cell:hover { background: #fafafa; }
  .walkaway-cell + .walkaway-cell { border-top: 1px solid var(--tipm-outline); }
  .walkaway-icon { width: 2rem; height: 2rem; }
  @media (min-width: 768px) {
    .walkaway-grid .row > div:nth-child(odd) .walkaway-cell { border-right: 1px solid var(--tipm-outline); }
    .walkaway-cell + .walkaway-cell { border-top: none; }
    .walkaway-grid .row > div:nth-child(n + 3) .walkaway-cell { border-top: 1px solid var(--tipm-outline); }
  }

  /* ── Pricing card (brutalist) ── */
  .pricing-card {
    background: var(--tipm-warm-yellow);
    border: 2px solid var(--tipm-black);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-brutal);
    position: relative;
    overflow: hidden;
  }
  .pricing-badge {
    position: absolute;
    top: 0; right: 0;
    background: var(--tipm-golden);
    color: var(--tipm-black);
    font-weight: var(--fw-bold);
    font-size: .75rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    padding: .5rem 1rem;
    border-bottom-left-radius: var(--radius-lg);
  }
  .session-label {
    font-size: var(--fs-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: #888;
  }
  .session-value { font-weight: var(--fw-bold); font-size: var(--fs-m); margin-bottom: .125rem; }
  .session-sub { font-size: var(--fs-s); color: var(--tipm-text-muted); margin-bottom: 0; }

  /* ── Number circle ── */
  .num-circle {
    width: 2rem; height: 2rem;
    border-radius: 50%;
    background: var(--tipm-black);
    color: var(--tipm-white);
    display: flex; align-items: center; justify-content: center;
    font-weight: var(--fw-bold);
    font-size: var(--fs-s);
    flex-shrink: 0;
  }

  /* ── Huddle fit cards ── */
  .huddle-fit-card {
    background: var(--tipm-white);
    border-radius: var(--radius-2xl);
    padding: 1.75rem 2rem;
    box-shadow: var(--shadow-soft);
    border: 1px solid #f3f4f6;
    height: 100%;
  }

  /* ── Hero SVG art ── */
  .hero-art svg { width: 100%; max-width: 100%; height: auto; }
  .hero-art { display: flex; align-items: center; justify-content: center; }
  @media (max-width: 991px) {
    .hero-art { display: none !important; }
  }
</style>
