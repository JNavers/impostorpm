---
/**
 * Cookie consent, replacing the Iubenda script that came with Softr.
 *
 * Opt-in, not opt-out: nothing is captured until Accept is clicked. The audience
 * is largely Portugal and Spain, so GDPR applies and implied consent does not
 * count. The legal policy itself is still Iubenda's — only the banner is ours,
 * and the link below is what keeps that policy reachable.
 *
 * Decision stored in localStorage rather than a cookie, so the banner needs no
 * cookie of its own to remember that you declined cookies.
 */

const POLICY_URL = 'https://www.iubenda.com/privacy-policy/26472145/cookie-policy';
---

<div id="tipm-consent" class="consent" role="dialog" aria-live="polite" aria-label="Cookie consent" hidden>
  <p class="consent-text">
    We use analytics to understand what's useful on this site. Nothing is collected until you agree.
    <a href={POLICY_URL} target="_blank" rel="noreferrer">Cookie policy</a>
  </p>
  <div class="consent-actions">
    <button type="button" data-consent="decline" class="btn-outline-custom">Decline</button>
    <button type="button" data-consent="accept" class="btn-cta">Accept</button>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'tipm_consent';
    var el = document.getElementById('tipm-consent');
    if (!el) return;

    function read() {
      try { return localStorage.getItem(KEY); } catch (e) { return null; }
    }
    function write(v) {
      try { localStorage.setItem(KEY, v); } catch (e) { /* storage blocked; banner reappears next visit */ }
    }

    // Only ask if there is no decision yet. A previous "denied" is a decision:
    // re-prompting on every visit is what makes people click Accept to make it
    // go away, which is not consent.
    if (!read()) el.hidden = false;

    el.addEventListener('click', function (event) {
      var choice = event.target && event.target.getAttribute('data-consent');
      if (!choice) return;

      if (choice === 'accept') {
        write('granted');
        window.dispatchEvent(new Event('tipm:consent-granted'));
      } else {
        write('denied');
        window.dispatchEvent(new Event('tipm:consent-revoked'));
      }
      el.hidden = true;
    });

    // Footer "Cookie settings" reopens it so a decision can be changed, which
    // GDPR requires to be as easy as giving it.
    document.addEventListener('click', function (event) {
      var t = event.target;
      if (t && t.closest && t.closest('[data-consent-reopen]')) {
        event.preventDefault();
        el.hidden = false;
      }
    });
  })();
</script>

<style>
  .consent {
    position: fixed;
    z-index: 1080;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    max-width: 34rem;
    margin-inline: auto;
    padding: 1.25rem;
    background: var(--tipm-white);
    border: 1px solid var(--tipm-outline);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .consent[hidden] { display: none; }

  .consent-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--tipm-text-muted);
  }
  .consent-text a { white-space: nowrap; }

  .consent-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
  }

  @media (max-width: 767.98px) {
    /* Full width on small screens, and the buttons stay side by side so
       Decline is never harder to reach than Accept. */
    .consent { left: 0.75rem; right: 0.75rem; bottom: 0.75rem; }
    .consent-actions { justify-content: center; }
  }
</style>
