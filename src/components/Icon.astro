---
/**
 * Inline SVG icons.
 *
 * Replaces Font Awesome 6.5.0, which every page loaded from
 * assets.softr-files.com — a stylesheet that dies the day Softr is
 * cancelled. Only a handful of glyphs were ever used, so an icon font plus a
 * render-blocking third-party stylesheet was never a good trade.
 *
 * UI icons are stroked and inherit `currentColor`; brand marks are filled.
 */

export type IconName =
  | 'arrow-down'
  | 'users'
  | 'lock'
  | 'award'
  | 'target'
  | 'eye'
  | 'people-group'
  | 'comments'
  | 'bolt'
  | 'chevron-down'
  | 'user-shield'
  | 'filter'
  | 'chart-simple'
  | 'globe'
  | 'linkedin'
  | 'slack'
  | 'luma';

interface Props {
  name: IconName;
  class?: string;
  /**
   * Rendered size, any CSS length. Set as width/height ATTRIBUTES rather than
   * left to a stylesheet: a scoped `<style>` in the calling page cannot reach
   * an element rendered by this component, so a class alone silently leaves the
   * SVG at its default and it blows up to fill its container.
   */
  size?: string;
  /** Decorative by default. Pass a label when the icon is the only content. */
  label?: string;
}

const { name, class: className, size = '1em', label } = Astro.props;

const STROKE = new Set<IconName>([
  'arrow-down', 'users', 'lock', 'award', 'target', 'eye', 'people-group', 'comments', 'bolt',
  'chevron-down', 'user-shield', 'filter', 'chart-simple', 'globe',
]);
const stroked = STROKE.has(name);

const a11y = label
  ? { role: 'img', 'aria-label': label }
  : { 'aria-hidden': 'true', focusable: 'false' };
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  fill={stroked ? 'none' : 'currentColor'}
  stroke={stroked ? 'currentColor' : undefined}
  stroke-width={stroked ? 1.75 : undefined}
  stroke-linecap={stroked ? 'round' : undefined}
  stroke-linejoin={stroked ? 'round' : undefined}
  xmlns="http://www.w3.org/2000/svg"
  {...a11y}
>
  {label && <title>{label}</title>}

  {name === 'arrow-down' && <><path d="M12 4v15" /><path d="M5.5 12.5 12 19l6.5-6.5" /></>}

  {name === 'users' && <>
    <circle cx="9" cy="8" r="3.25" />
    <path d="M2.75 19.5a6.25 6.25 0 0 1 12.5 0" />
    <path d="M16 5.4a3.25 3.25 0 0 1 0 6.2" />
    <path d="M17.5 14.2a6.25 6.25 0 0 1 3.75 5.3" />
  </>}

  {name === 'lock' && <>
    <rect x="4" y="10.5" width="16" height="10" rx="2.25" />
    <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
    <circle cx="12" cy="15.5" r="1.1" fill="currentColor" stroke="none" />
  </>}

  {name === 'award' && <>
    <circle cx="12" cy="9" r="5.5" />
    <path d="M8.4 13.6 7 21l5-2.4L17 21l-1.4-7.4" />
  </>}

  {name === 'target' && <>
    <circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="4.75" />
    <circle cx="12" cy="12" r="1.35" fill="currentColor" stroke="none" />
  </>}

  {name === 'eye' && <>
    <path d="M1.75 12S5.5 5.5 12 5.5 22.25 12 22.25 12 18.5 18.5 12 18.5 1.75 12 1.75 12Z" />
    <circle cx="12" cy="12" r="3.1" />
  </>}

  {name === 'people-group' && <>
    <circle cx="12" cy="6.75" r="2.9" />
    <path d="M7.5 15.25a4.5 4.5 0 0 1 9 0" />
    <circle cx="4.5" cy="10.75" r="2.15" />
    <path d="M1.25 18a3.4 3.4 0 0 1 4.6-3.2" />
    <circle cx="19.5" cy="10.75" r="2.15" />
    <path d="M22.75 18a3.4 3.4 0 0 0-4.6-3.2" />
  </>}

  {name === 'comments' && <>
    <path d="M2.75 6.5A2.25 2.25 0 0 1 5 4.25h9A2.25 2.25 0 0 1 16.25 6.5v4A2.25 2.25 0 0 1 14 12.75H7.5L3.5 16v-3.25a2.25 2.25 0 0 1-.75-1.68Z" />
    <path d="M18.5 8.25h.5a2.25 2.25 0 0 1 2.25 2.25v4a2.25 2.25 0 0 1-.75 1.68V19.5l-3.2-2.5H13" />
  </>}

  {name === 'bolt' && <path d="M13.5 2.5 4.75 13.6h5.9L10.5 21.5l8.75-11.1h-5.9l.15-7.9Z" />}

  {name === 'chevron-down' && <path d="m5.5 9 6.5 6.5L18.5 9" />}

  {name === 'user-shield' && <>
    <path d="M12 2.75 4.75 5.5v5.4c0 4.6 3 8.3 7.25 10.35 4.25-2.05 7.25-5.75 7.25-10.35V5.5L12 2.75Z" />
    <circle cx="12" cy="10" r="2.4" />
    <path d="M8.3 16.6a4 4 0 0 1 7.4 0" />
  </>}

  {name === 'filter' && <path d="M3.25 5.25h17.5l-6.85 8v6l-3.8 1.9v-7.9l-6.85-8Z" />}

  {name === 'chart-simple' && <>
    <path d="M3.75 20.25h16.5" />
    <path d="M6.75 20.25v-6" /><path d="M12 20.25V4.5" /><path d="M17.25 20.25v-9.5" />
  </>}

  {name === 'globe' && <>
    <circle cx="12" cy="12" r="9.25" />
    <path d="M2.9 12h18.2" />
    <path d="M12 2.75c2.3 2.5 3.6 5.8 3.6 9.25S14.3 18.75 12 21.25c-2.3-2.5-3.6-5.8-3.6-9.25S9.7 5.25 12 2.75Z" />
  </>}

  {name === 'linkedin' && (
    <path d="M4.98 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM2.75 21h4.46V9.5H2.75V21Zm7.06 0h4.46v-6.05c0-1.6.6-2.55 1.98-2.55 1.28 0 1.83.87 1.83 2.55V21h4.46v-6.7c0-3.5-1.87-5.2-4.47-5.2-2.1 0-3.05 1.16-3.58 1.98V9.5H9.81c.06 1.15 0 11.5 0 11.5Z" />
  )}

  {name === 'slack' && (
    <path d="M6.2 14.7a1.9 1.9 0 1 1-1.9-1.9h1.9v1.9Zm.95 0a1.9 1.9 0 0 1 3.8 0v4.75a1.9 1.9 0 0 1-3.8 0V14.7ZM9.05 6.2a1.9 1.9 0 1 1 1.9-1.9v1.9h-1.9Zm0 .95a1.9 1.9 0 0 1 0 3.8H4.3a1.9 1.9 0 0 1 0-3.8h4.75ZM17.8 9.05a1.9 1.9 0 1 1 1.9 1.9h-1.9v-1.9Zm-.95 0a1.9 1.9 0 0 1-3.8 0V4.3a1.9 1.9 0 0 1 3.8 0v4.75ZM14.95 17.8a1.9 1.9 0 1 1-1.9 1.9v-1.9h1.9Zm0-.95a1.9 1.9 0 0 1 0-3.8h4.75a1.9 1.9 0 0 1 0 3.8h-4.75Z" />
  )}

  {name === 'luma' && <path d="M12 1q0 11 11 11-11 0-11 11 0-11-11-11 11 0 11-11Z" />}
</svg>
